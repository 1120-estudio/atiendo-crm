      "lane": "data",
      "col": 3,
      "type": "database",
      "label": "catalog_products + RLS por organização"
    },
    {
      "id": "busca",
      "lane": "agent",
      "col": 4,
      "type": "backend",
      "label": "crm_search_products: preço e descrição"
